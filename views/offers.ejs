<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Corte Fino - Açougue Gourmet</title>

    <!-- BOOTSTRAP CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- FAVICON -->
    <link rel="shortcut icon" href="/images/icon-Corte-Fino.ico" />

    <!-- ICONES -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css"
      rel="stylesheet"
    />

    <!-- FONTE -->
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- CSS (PADRÃO DO INDEX) -->

    <link rel="stylesheet" href="/CSS/style.css" />
  </head>

  <body>
    <%- include("partials/header", { currentPage: "offers" }) %>
    <!-- HEADER TOP - Informações de contato -->
    <section>


    <!-- OFERTAS - produtos com promocao em vigor (vem do banco) -->
    <section class="highlights-of-the-week1 py-5">
      <div class="container">
        <h2 class="text-center fw-bold mb-2" style="color: #2e1a16">
          Ofertas da Semana
        </h2>

        <p class="sub-high text-center mb-5">
          Cortes selecionados com preço especial por tempo limitado
        </p>

        <%
          // imagem padrao de cada tipo (mesma regra da pagina de produtos)
          const imagensPorTipo = {
            bovino: "/images/Cards-Produtos/picanha-bovina-card.png",
            suino: "/images/Cards-Produtos/panceta-products.png",
            ave: "/images/Cards-Produtos/frango-resfriado-products.png",
            kit: "/images/Cards-Produtos/kit-churrasco-products.png",
          };
          // "89.9" -> "89,90"
          const moeda = (valor) => Number(valor).toFixed(2).replace(".", ",");
          // "2026-11-25" -> "25/11/2026"
          const data = (texto) => String(texto).split("-").reverse().join("/");
        %>

        <% if (ofertas.length == 0) { %>
        <p class="text-center">
          Nenhuma oferta no momento. Volte em breve ou confira
          <a href="/products">todos os nossos produtos</a>.
        </p>
        <% } %>

        <div class="row g-4 justify-content-center">
          <% for (let i = 0; i < ofertas.length; i++) { %>
          <%
            const oferta = ofertas[i];
            const tipo = String(oferta.NOME_CATEGORIA || "")
              .normalize("NFD")
              .replace(/[̀-ͯ]/g, "")
              .toLowerCase()
              .trim();
            const chaveImagem = Object.keys(imagensPorTipo).find((chave) => tipo.startsWith(chave));
            const selo = oferta.DESCONTO_PORC != null
              ? "-" + Number(oferta.DESCONTO_PORC) + "%"
              : "Preço especial";
            const mensagem = "Olá Corte Fino, tenho interesse na oferta de " + oferta.NOME_PRODUTO + ".";
          %>
          <div class="col-12 col-md-6 col-lg-4">
            <!-- card-oferta + data-*: usados pelo cart.js no "Adicionar ao Pedido" -->
            <div
              class="card-produto card-oferta h-100"
              data-id="<%= oferta.ID_PRODUTO %>"
              data-preco="<%= oferta.PRECO_PROMOCIONAL %>"
              data-estoque="<%= oferta.QNT_ESTOQUE %>"
            >
              <div class="badge-card"><%= selo %></div>

              <img
                src="<%= imagensPorTipo[chaveImagem] || imagensPorTipo.bovino %>"
                class="img-produto"
                alt="<%= oferta.NOME_PRODUTO %>"
              />
              <h3 class="nome-produto"><%= oferta.NOME_PRODUTO %></h3>
              <p><%= oferta.DESCRICAO %></p>

              <div class="info-carne">
                <span class="categoria-produto"><%= oferta.NOME_CATEGORIA %></span>
                <span>Marca <%= oferta.NOME_MARCA %></span>
                <span>Oferta válida até <%= data(oferta.DATA_FIM) %></span>
              </div>

              <div class="preco-card">
                <span class="preco-antigo"> R$ <%= moeda(oferta.PRECO_VENDA) %>/kg </span>
                <span class="preco-novo"> R$ <%= moeda(oferta.PRECO_PROMOCIONAL) %> </span>
              </div>

              <% if (oferta.QNT_ESTOQUE > 0) { %>
              <button class="btn-adicionar mt-3">Adicionar ao Pedido</button>
              <% } else { %>
              <button class="btn-adicionar mt-3" disabled>Esgotado</button>
              <% } %>

              <a
                href="https://wa.me/5518997732006?text=<%= encodeURIComponent(mensagem) %>"
                target="_blank"
              >
                <button class="button-orçamento w-100 mt-2">
                  Pedir no WhatsApp
                </button>
              </a>
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </section>
<!-- FOOTER -->
    <%- include("partials/footer", { footerType: "default" }) %>

    <script src="/JS/scripts/cart.js"></script>
  </body>
</html>
